# Copy to .env for local use. Never commit .env.
#
# The deploy workflow generates .env from this file on every run: the image tag
# comes from the build and MAILFLOW_API_PORT from the "production" environment.
# A value edited in a checkout does not survive, because the checkout is cleaned.

MAILFLOW_API_IMAGE=mailflow-api:dev

# Host loopback port for the published API. On a deployed host, set
# MAILFLOW_API_PORT in the "production" environment instead of editing this file.
# The deploy fails before creating a container if another container already
# publishes the port.
MAILFLOW_API_PORT=8080

# Where the service reaches the mail container, and the name its certificate
# must cover. These differ on purpose: the URL is a routing address, the
# hostname is the certificate identity.
MAILFLOW_JMAP_URL=https://mailflow-stalwart/jmap/
MAILFLOW_JMAP_HOSTNAME=mail.mailflow.test

# The mail Compose project's network. The mail project must exist first.
MAILFLOW_MAIL_NETWORK=mailflow-mail_default

# Bounds. Defaults are fine unless a consumer needs otherwise.
MAILFLOW_REQUEST_TIMEOUT=10s
MAILFLOW_PAGE_SIZE_DEFAULT=25
MAILFLOW_PAGE_SIZE_MAX=100
MAILFLOW_BODY_MAX_BYTES=262144

# Application database. Pinned by exact release; the digest is recorded in
# docs/application-database.md. It holds idempotency records, never mail.
MAILFLOW_DB_IMAGE=postgres:18.4-alpine
MAILFLOW_DB_NAME=mailflow
MAILFLOW_DB_USER=mailflow

# Local placeholder only. On a deployed host the deploy writes
# MAILFLOW_DB_PASSWORD from the "production" environment into this file and no
# tracked file carries the real value.
MAILFLOW_DB_PASSWORD=change-me-local-db

# Idempotency window. The lease must exceed MAILFLOW_REQUEST_TIMEOUT; startup
# refuses a shorter one.
MAILFLOW_IDEMPOTENCY_TTL=24h
MAILFLOW_IDEMPOTENCY_LEASE=2m

# Send bounds: recipients per message and text body bytes.
MAILFLOW_SEND_MAX_RECIPIENTS=50
MAILFLOW_SEND_MAX_BYTES=262144
