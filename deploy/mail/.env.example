# Copy to .env and fill in. Never commit .env.
#
# The image is pinned by exact release, not by the moving v1 tag, so the
# deployed version is reproducible and matches what docs/mail-infrastructure.md
# records. Upgrading is a deliberate change, not a side effect of a pull.

STALWART_IMAGE=ghcr.io/stalwartlabs/stalwart:v1.1.0

# Reserved, non-routable test domain. No public mail, no MX records.
MAIL_DOMAIN=mailflow.test
MAIL_HOSTNAME=mail.mailflow.test

MAIL_DATA_DIR=./data

MAIL_IMAPS_PORT=993
MAIL_SUBMISSION_PORT=465
MAIL_HTTPS_PORT=443
MAIL_SETUP_PORT=8080

# Used only by compose.bootstrap.yaml on the very first start.
MAIL_BOOTSTRAP_PASSWORD=change-me-before-first-start

# Demonstration accounts. Local parts only; the domain comes from MAIL_DOMAIN.
MAIL_ACCOUNT_ALICE=alice
MAIL_ACCOUNT_ALICE_PASSWORD=change-me-alice
MAIL_ACCOUNT_BOB=bob
MAIL_ACCOUNT_BOB_PASSWORD=change-me-bob
